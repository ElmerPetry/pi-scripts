   <platform os="all" arch="noarch" version="1.9.4:1.9.9">
      <package fileName="202609112103-epyscripts.tar.gz" sha1="a0cbb869461943086876439613c2b73425d59c02" type="script" releaseDate="202609112103">
         <title>
            SmartIndicator Version 1.6.0
         </title>
         <description>
            <p>
               This update installs the script SmartIndicator Version 1.6.0
               for PixInsight.
            </p>
            <p>
               Under Script → Render you will find SmartIndicator. It enables you to generate and blend an indicator (scale, orientation, angular separation, or text) onto a target image. 
            </p>
            <p>
               Last update: added new text indicator type, optimisations, updated doc
            </p>
            <p>
               Copyright (c) 2024-2026 Elmer Petry. All Rights Reserved.
            </p>
         </description>
      </package>
   </platform>
