   <platform os="all" arch="noarch" version="1.9.4:1.9.9">
      <package fileName="202609121244-epyscripts.tar.gz" sha1="df1fbecbfb2b4d6a1e60f8eb6bf0b2c1588ccba5" type="script" releaseDate="202609121244">
         <title>
            SmartIndicator Version 1.6.1
         </title>
         <description>
            <p>
               This update installs the script SmartIndicator Version 1.6.1
               for PixInsight.
            </p>
            <p>
               Under Script → Render you will find SmartIndicator. It enables you to generate and blend an indicator (scale, orientation, angular separation, or text) onto a target image. 
            </p>
            <p>
               Last update: improved text indicator rendering for large fonts
            </p>
            <p>
               Copyright (c) 2024-2026 Elmer Petry. All Rights Reserved.
            </p>
         </description>
      </package>
   </platform>
