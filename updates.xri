   <platform os="all" arch="noarch" version="1.9.4:1.9.9">
      <package fileName="202608201953-epyscripts.tar.gz" sha1="eb9c23f3c86286727d82876b5fbf430d89c6776a" type="script" releaseDate="202608201953">
         <title>
            SmartIndicator Version 1.5.1
         </title>
         <description>
            <p>
               This update installs the script SmartIndicator Version 1.5.1
               for PixInsight.
            </p>
            <p>
               Under Script → Render you will find SmartIndicator. It enables you to generate and blend an indicator (scale, orientation, or angular separation) onto a target image. 
            </p>
            <p>
               Last update: ported to new engine v8, optimisations, updated doc
            </p>
            <p>
               Copyright (c) 2024-2026 Elmer Petry. All Rights Reserved.
            </p>
         </description>
      </package>
   </platform>
